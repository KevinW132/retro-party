{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "lib": ["ES2020"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "outDir": "dist",
    "rootDir": "src",
    "paths": {
      "@retro-party/shared": ["../shared/dist/index.d.ts"],
      "@retro-party/shared/*": ["../shared/dist/*"]
    }
  },
  "include": ["src"]
}
