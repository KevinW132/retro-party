# Copy this file to `.env` in the same folder (server/.env)

# Port the Express + Socket.IO server listens on
SERVER_PORT=4000

# Comma-separated list of allowed frontend origins (CORS)
CLIENT_ORIGIN=http://localhost:5173

# Optional. If set, the Trivia game uses OpenAI to generate questions.
# If left empty, Trivia (and every other game) falls back to the local
# datasets in server/src/data — the app works fully without this key.
OPENAI_API_KEY=
